# env file for e2e testing
DB_HOST='localhost'
DB_PORT=5433
DB_USERNAME='user'
DB_PASSWORD='password'
DB_NAME='ddh_tests' # running tests in a separate test db
DATABASE_URL="postgresql://user:password@localhost:5433/ddh_tests"

# Firebase — required by env.validation.ts, but real credentials are never
# used in tests: FIREBASE_AUTH_EMULATOR_HOST below makes the Admin SDK talk
# to the local Auth Emulator instead (see firebase-admin.service.ts), which
# needs no real credentials at all.
FIREBASE_PROJECT_ID='demo-voit-test'
FIREBASE_CLIENT_EMAIL='firebase-adminsdk-test@demo-voit-test.iam.gserviceaccount.com'
FIREBASE_PRIVATE_KEY='not-used-with-the-emulator'
FIREBASE_STORAGE_BUCKET='demo-voit-test.firebasestorage.app'
FIREBASE_AUTH_EMULATOR_HOST='127.0.0.1:9099'

CORS_ORIGIN='http://localhost:3000'
