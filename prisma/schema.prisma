generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ACCOUNT
  CONTACT
}

model User {
  id        String   @id // Firebase UID for a real account, generated UUID for a contact
  firstName String
  lastName  String?
  /// Discriminator: tells you whether to look up `account` or `contact` for
  /// the additional fields, without probing both relations. Must stay in
  /// sync with which of the two actually has a row for this userId — kept
  /// consistent by always creating User + Account (or User + Contact)
  /// together in the same transaction, never separately.
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account?
  contact Contact?

  expensePayments        ExpensePayer[] @relation("ExpensePayerUser")
  imputedExpensePayments ExpensePayer[] @relation("ImputedExpensePayments")
  cashedVehicles         SoldVehicle[]

  @@map("users")
}

model Account {
  userId    String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallet              Wallet?
  contacts            Contact[]
  ownedVehicles       Vehicle[]
  debts               Debt[]
  recurringCharges    RecurringCharge[]
  monthlyBudgets      MonthlyBudget[]
  manualSavingsEvents ManualSavingsEvent[]

  @@map("accounts")
}

model Contact {
  userId    String    @id
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete marker. A contact with real history (debts, expense
  /// payments, vehicle sale cashier) can't be hard-deleted without breaking
  /// that history's readability — see ContactRepository.delete().
  deletedAt DateTime?

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner Account @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  debts          Debt[]
  participations VehicleParticipant[]

  @@index([ownerId])
  @@map("contacts")
}

model Wallet {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balance   Int      @default(0)
  userId    String   @unique
  /// Cascade: without Cascade, deleting an account fails (FK constraint).
  /// Domain events are published after the DB delete, so they can't
  /// clean up the wallet before the account is removed.
  account   Account  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("wallets")
}

model Vehicle {
  id            String   @id
  ownerId       String
  name          String
  purchaseDate  DateTime
  purchasePrice Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         Account              @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  participants  VehicleParticipant[]
  expenses      Expense[]
  vehicleEvents VehicleEvent[]
  soldVehicle   SoldVehicle?

  @@map("vehicles")
}

model SoldVehicle {
  id         String   @id
  vehicleId  String   @unique
  salePrice  Int
  soldAt     DateTime
  cashierId  String
  /// Only meaningful when the cashier is the account owner — same reasoning
  /// as ExpensePayer.source. Split across both like ManualDebt.bankAmount/
  /// cashAmount, since a sale can genuinely be paid partly by transfer,
  /// partly in cash.
  bankAmount Int?
  cashAmount Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// User (not Account/Contact directly): either the account owner or one of
  /// their contacts can be the one who physically cashed the sale.
  cashier          User              @relation(fields: [cashierId], references: [id])
  /// The debts a sale settles between beneficiaries — deleting the sale
  /// deletes them too, since they only exist to represent this sale's payout.
  soldVehicleDebts SoldVehicleDebt[]

  @@map("sold_vehicles")
}

// Co-owners* because the user who created the vehicle record is already a partipant via ownerId
model VehicleParticipant {
  vehicleId   String
  contactId   String
  profitShare Decimal

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [userId], onDelete: Cascade)

  @@id([vehicleId, contactId])
  @@map("vehicle_participants")
}

model Expense {
  id        String   @id
  vehicleId String
  label     String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payers       ExpensePayer[]
  expenseDebts ExpenseDebt[]

  @@map("expenses")
}

// A free-form note about a vehicle — no amount, no payer, unrelated to
// expenses/debts. Just a dated journal entry (e.g. "seller said only the
// starter needed replacing, turned out the whole engine did").
// No date on purpose — a note often describes a saga spanning weeks or
// months, not a single moment, so it isn't placed in the dated expense
// timeline. It lives in its own list, most recent first by createdAt.
model VehicleEvent {
  id        String   @id
  vehicleId String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_events")
}

model ExpensePayer {
  id          String         @id @default(uuid())
  expenseId   String
  payerId     String
  amount      Int
  /// Only meaningful when the payer is the account owner — it tracks which
  /// of their own money pools (bank/cash) got debited. Null for a contact:
  /// their money never touches the owner's tracked balances.
  source      SavingsSource?
  imputedToId String?

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// User (not Account/Contact directly): either the account owner or one of
  /// their contacts can be the one who paid.
  payer     User    @relation("ExpensePayerUser", fields: [payerId], references: [id])
  imputedTo User?   @relation("ImputedExpensePayments", fields: [imputedToId], references: [id])

  @@index([expenseId, payerId])
  @@map("expense_payers")
}

// ─── Debt tracking ────────────────────────────────────────────────────────────

enum DebtType {
  MANUAL
  SOLD_VEHICLE
  EXPENSE
}

enum DebtRole {
  LENDER
  BORROWER
}

enum DebtOverrideStatus {
  MANUALLY_SETTLED
  FORGIVEN
}

model Debt {
  id        String   @id
  ownerId   String
  contactId String
  role      DebtRole
  amount    Int
  date      DateTime
  type      DebtType
  /// Explicit override of the otherwise fully-computed repaid status — null
  /// means no override (isRepaid/isForgiven stay derived from
  /// totalRepaid/amount). A single nullable column so the two overrides can
  /// never both apply at once; see DebtEntity.isRepaid/isForgiven.
  overrideStatus DebtOverrideStatus?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   Account @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  /// No onDelete: Cascade on purpose — the default Restrict blocks deleting a
  /// contact that still has open debts.
  contact Contact @relation(fields: [contactId], references: [userId])

  repayments      Repayment[]
  manualDebt      ManualDebt?
  soldVehicleDebt SoldVehicleDebt?
  expenseDebt     ExpenseDebt?

  @@map("debts")
}

model ManualDebt {
  debtId      String   @id
  description String?
  /// Only set when the authenticated user is the lender (tracks how the money was lent)
  bankAmount  Int?
  cashAmount  Int?

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("manual_debts")
}

model SoldVehicleDebt {
  debtId        String @id
  soldVehicleId String

  debt        Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  /// Deleting the sale deletes this settlement debt with it — it has no
  /// meaning independent of the sale that generated it.
  soldVehicle SoldVehicle @relation(fields: [soldVehicleId], references: [id], onDelete: Cascade)

  @@map("sold_vehicle_debts")
}

model ExpenseDebt {
  debtId    String @id
  expenseId String

  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_debts")
}

model Repayment {
  id        String        @id
  debtId    String
  amount    Int
  date      DateTime
  note      String?
  source    SavingsSource
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("repayments")
}

// ─── Recurring charges ────────────────────────────────────────────────────────

enum RecurringChargeType {
  AUTOMATIC
  MANUAL
}

model RecurringCharge {
  id         String    @id
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  inactiveAt DateTime?

  userId  String
  account Account                  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  history RecurringChargeHistory[]

  @@map("recurring_charges")
}

/// One row per edit — name/amount/type/dueDay live here, never on
/// RecurringCharge itself. The "current" version is simply the most
/// recent row by createdAt — no stored pointer needed, which also avoids
/// a circular FK at creation time (charge needs a version, version needs
/// a charge). A month already generated keeps pointing to the exact
/// version that was current when it was built, unaffected by later edits.
model RecurringChargeHistory {
  id                String              @id
  name              String
  amount            Int
  type              RecurringChargeType
  dueDay            Int?
  createdAt         DateTime            @default(now())
  /// Nullable, SetNull on delete — if the parent charge is deleted, this
  /// version must survive forever, since it's what keeps past months
  /// readable (same guarantee the old nullable FK on the monthly tables
  /// used to provide, just moved one level up).
  recurringChargeId String?

  recurringCharge RecurringCharge?         @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)
  monthlyCharges  MonthlyRecurringCharge[]

  @@map("recurring_charge_histories")
}

// ─── Monthly budget ───────────────────────────────────────────────────────────

model MonthlyBudget {
  id             String   @id
  userId         String
  year           Int
  month          Int
  receivedSalary Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account            Account                          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  recurringCharges   MonthlyRecurringCharge[]
  savingsWithdrawals MonthlyBudgetSavingsWithdrawal[]

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}

/// A line item for a given month, frozen to the exact recurring-charge
/// version that was current at generation time — never repointed
/// afterwards, which is what keeps past months immune to later edits.
model MonthlyRecurringCharge {
  id                       String   @id
  budgetId                 String
  recurringChargeHistoryId String
  createdAt                DateTime @default(now())

  budget                 MonthlyBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  recurringChargeHistory RecurringChargeHistory @relation(fields: [recurringChargeHistoryId], references: [id])

  @@map("monthly_recurring_charges")
}

model MonthlyBudgetSavingsWithdrawal {
  id        String        @id
  budgetId  String
  amount    Int
  source    SavingsSource
  date      DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  budget MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("monthly_budget_savings_withdrawals")
}

// ─── Savings ──────────────────────────────────────────────────────────────────

enum SavingsSource {
  BANK
  CASH
}

enum SavingsMovementKind {
  ADDITION
  WITHDRAWAL
}

model ManualSavingsEvent {
  id        String              @id
  userId    String
  kind      SavingsMovementKind
  source    SavingsSource
  amount    Int
  label     String
  date      DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("manual_savings_events")
}
