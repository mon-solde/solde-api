generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  ACCOUNT
  CONTACT
}

model User {
  id        String   @id // Firebase UID for a real account, generated UUID for a contact
  firstName String
  lastName  String?
  /// Discriminator: tells you whether to look up `account` or `contact` for
  /// the additional fields, without probing both relations. Must stay in
  /// sync with which of the two actually has a row for this userId — kept
  /// consistent by always creating User + Account (or User + Contact)
  /// together in the same transaction, never separately.
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account?
  contact Contact?

  expensePayments        ExpensePayer[] @relation("ExpensePayerUser")
  imputedExpensePayments ExpensePayer[] @relation("ImputedExpensePayments")
  cashedVehicles         SoldVehicle[]

  @@map("users")
}

model Account {
  userId    String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallet              Wallet?
  contacts            Contact[]
  ownedVehicles       Vehicle[]
  debts               Debt[]
  recurringCharges    RecurringCharge[]
  monthlyBudgets      MonthlyBudget[]
  manualSavingsEvents ManualSavingsEvent[]

  @@map("accounts")
}

model Contact {
  userId    String   @id
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner Account @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  debts          Debt[]
  participations VehicleParticipant[]

  @@index([ownerId])
  @@map("contacts")
}

model Wallet {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balance   Int      @default(0)
  userId    String   @unique
  /// Cascade: without Cascade, deleting an account fails (FK constraint).
  /// Domain events are published after the DB delete, so they can't
  /// clean up the wallet before the account is removed.
  account   Account  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("wallets")
}

model Vehicle {
  id            String   @id
  ownerId       String
  name          String
  purchaseDate  DateTime
  purchasePrice Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner        Account              @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  participants VehicleParticipant[]
  expenses     Expense[]
  soldVehicle  SoldVehicle?
  vehicleDebts VehicleDebt[]

  @@map("vehicles")
}

model SoldVehicle {
  id        String        @id
  vehicleId String        @unique
  salePrice Decimal
  soldAt    DateTime
  cashierId String
  source    SavingsSource @default(BANK)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// User (not Account/Contact directly): either the account owner or one of
  /// their contacts can be the one who physically cashed the sale.
  cashier User    @relation(fields: [cashierId], references: [id])

  @@map("sold_vehicles")
}

model VehicleParticipant {
  vehicleId   String
  contactId   String
  profitShare Decimal

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [userId], onDelete: Cascade)

  @@id([vehicleId, contactId])
  @@map("vehicle_participants")
}

model Expense {
  id        String   @id
  vehicleId String
  label     String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payers       ExpensePayer[]
  expenseDebts ExpenseDebt[]

  @@map("expenses")
}

model ExpensePayer {
  id          String        @id @default(uuid())
  expenseId   String
  payerId     String
  amount      Decimal
  source      SavingsSource @default(BANK)
  imputedToId String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// User (not Account/Contact directly): either the account owner or one of
  /// their contacts can be the one who paid.
  payer     User  @relation("ExpensePayerUser", fields: [payerId], references: [id])
  imputedTo User? @relation("ImputedExpensePayments", fields: [imputedToId], references: [id])

  @@index([expenseId, payerId])
  @@map("expense_payers")
}

// ─── Debt tracking ────────────────────────────────────────────────────────────

enum DebtType {
  MANUAL
  VEHICLE
  EXPENSE
}

enum DebtRole {
  LENDER
  BORROWER
}

model Debt {
  id        String   @id
  ownerId   String
  contactId String
  role      DebtRole
  amount    Decimal
  date      DateTime
  type      DebtType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Account @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  /// No onDelete: Cascade on purpose — the default Restrict blocks deleting a
  /// contact that still has open debts.
  contact Contact @relation(fields: [contactId], references: [userId])

  repayments  Repayment[]
  manualDebt  ManualDebt?
  vehicleDebt VehicleDebt?
  expenseDebt ExpenseDebt?

  @@map("debts")
}

model ManualDebt {
  debtId      String   @id
  description String?
  /// Only set when the authenticated user is the lender (tracks how the money was lent)
  bankAmount  Decimal?
  cashAmount  Decimal?

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("manual_debts")
}

model VehicleDebt {
  debtId    String @id
  vehicleId String

  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_debts")
}

model ExpenseDebt {
  debtId    String @id
  expenseId String

  debt    Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_debts")
}

model Repayment {
  id        String        @id
  debtId    String
  amount    Decimal
  date      DateTime
  note      String?
  source    SavingsSource
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("repayments")
}

// ─── Recurring charges ────────────────────────────────────────────────────────

enum RecurringChargeType {
  AUTOMATIC
  MANUAL
}

model RecurringCharge {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name       String
  amount     Decimal
  type       RecurringChargeType
  dueDay     Int?
  inactiveAt DateTime?

  userId  String
  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  monthlyAutomaticEntries MonthlyAutomaticDeduction[]
  monthlyManualEntries    MonthlyManualAction[]

  @@map("recurring_charges")
}

// ─── Monthly budget ───────────────────────────────────────────────────────────

model MonthlyBudget {
  id             String   @id
  userId         String
  year           Int
  month          Int
  receivedSalary Decimal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account             Account                          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  automaticDeductions MonthlyAutomaticDeduction[]
  manualActions       MonthlyManualAction[]
  savingsWithdrawals  MonthlyBudgetSavingsWithdrawal[]

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}

model MonthlyAutomaticDeduction {
  id                String   @id
  budgetId          String
  /// Nullable FK — keeps traceability without blocking recurring charge deletion.
  recurringChargeId String?
  label             String
  amount            Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  budget          MonthlyBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  recurringCharge RecurringCharge? @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)

  @@map("monthly_automatic_deductions")
}

model MonthlyManualAction {
  id                String   @id
  budgetId          String
  /// Nullable FK — keeps traceability without blocking recurring charge deletion.
  recurringChargeId String?
  label             String
  plannedAmount     Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  budget          MonthlyBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  recurringCharge RecurringCharge? @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)
  payments        ActionPayment[]

  @@map("monthly_manual_actions")
}

model ActionPayment {
  id          String   @id
  actionId    String
  amount      Decimal
  paymentDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  action MonthlyManualAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_payments")
}

model MonthlyBudgetSavingsWithdrawal {
  id        String        @id
  budgetId  String
  amount    Decimal
  source    SavingsSource
  date      DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  budget MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("monthly_budget_savings_withdrawals")
}

// ─── Savings ──────────────────────────────────────────────────────────────────

enum SavingsSource {
  BANK
  CASH
}

enum SavingsMovementKind {
  ADDITION
  WITHDRAWAL
}

model ManualSavingsEvent {
  id        String              @id
  userId    String
  kind      SavingsMovementKind
  source    SavingsSource
  amount    Decimal
  label     String
  date      DateTime
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("manual_savings_events")
}
